        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(gen_ai_client_inference_usage_cache_write_input_tokens_total{gen_ai_request_model=~\"$model\",llmspan_caller=~\"$caller\"}[$__rate_interval])) or vector(0)",
