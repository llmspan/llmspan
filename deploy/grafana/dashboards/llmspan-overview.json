    {
      "id": 15,
      "type": "table",
      "title": "Recent LLM calls",
      "description": "Latest GenAI spans from Tempo (TraceQL). Click a trace ID to open the full trace.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
