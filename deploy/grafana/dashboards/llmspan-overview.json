          "expr": "sum by (gen_ai_request_model) (rate(gen_ai_client_inference_usage_output_tokens_total{gen_ai_request_model=~\"$model\",llmspan_caller=~\"$caller\"}[$__rate_interval]))",
          "legendFormat": "{{gen_ai_request_model}} output"
