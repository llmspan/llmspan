          },
          "expr": "sum by (gen_ai_request_model) (rate(gen_ai_client_inference_usage_input_tokens_total{gen_ai_request_model=~\"$model\",llmspan_caller=~\"$caller\"}[$__rate_interval]))",
          "legendFormat": "{{gen_ai_request_model}} input"
        },
        {
          "refId": "B",
